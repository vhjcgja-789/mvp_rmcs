<?xml version="1.0"?>
<!-- RMCS 对照：用 launch 组织组件清单和参数，对应 rmcs_bringup。 -->
<package format="3">
  <name>mvp_bringup</name>
  <version>0.0.1</version>
  <description>单关节闭环的原生组件容器启动配置</description>
  <maintainer email="yuyuyu@example.com">yuyuyu</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>mvp_core</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
