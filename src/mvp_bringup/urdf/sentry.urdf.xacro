<?xml version="1.0"?>
<robot name="sentry" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 几何在阶段 14 补全,这里只放关节拓扑 -->
  <link name="base_link"/>
  <link name="chassis_wheel_lb_link"/>
  <joint name="chassis_wheel_lb" type="continuous">
    <parent link="base_link"/>
    <child link="chassis_wheel_lb_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- 底板:一块 C 板 -->
  <ros2_control name="bottom_board" type="system">
    <hardware>
      <plugin>mvp_hardware/CBoardSystem</plugin>
      <param name="serial_number">d4-2184</param>
      <!-- RMCS 底板跳过固件版本检查(sentry.cpp BottomBoard 构造函数),阶段 0 实测后按需改 -->
      <param name="skip_version_check">true</param>
    </hardware>

    <!-- 哨兵左后轮:can1,反馈 0x201 -->
    <joint name="chassis_wheel_lb">
      <!-- 台架:裸 3508 带原装减速箱;装车后按 RMCS 改为 11,reversed=true -->
      <param name="reduction_ratio">${3591 / 187}</param>
      <param name="reversed">false</param>
      <param name="multi_turn">true</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
