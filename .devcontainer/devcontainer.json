{
  "name": "mvp_rmcs (ROS2 Jazzy 最小环境)",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "mvp_rmcs",
  "workspaceFolder": "/workspaces/mvp_rmcs",
  "initializeCommand": "bash ${localWorkspaceFolder}/.devcontainer/scripts/ensure-proxy.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "smilerobotics.urdf",
        "mhutchie.git-graph",
        "yzhang.markdown-all-in-one",
        "marscode.marscode-extension"
      ],
      "settings": {
        "C_Cpp.default.cppStandard": "c++23",
        "cmake.configureOnOpen": false
      }
    }
  },
  "postCreateCommand": "echo '就绪: /workspaces/mvp_rmcs <-> 主机 mvp_rmcs/'"
}
